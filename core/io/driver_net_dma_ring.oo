// # Zero-Copy NIC RX/TX DMA Packet Descriptor Rings & MMIO Doorbells
//
// Logline: 16-byte NIC RX/TX DMA descriptors and BAR MMIO doorbells under DmaCap/MmioCap; OODA turns and warrants.
// Setup: DmaCap, MmioCap. Imports std/core/ooda.oo, std/sec/*, and std/ipc/wire.oo.
// Beats:
//   1. Declare NetPacketDesc and NetDmaRing structures for IOMMU-pinned RX/TX rings.
//   2. Initialize RX/TX descriptor rings and PCIe BAR0 RDT/TDT doorbell offsets under &DmaCap, &MmioCap.
//   3. Gate TX submission on an OODA turn + speculative checkpoint + capability warrant + IPC wire frame.
//   4. Poll RX DD/EOP status descriptors and verify quorum/blackbox flight-recorder traces.
import "oostd/core/ooda.oo";
import "oostd/sec/capreg.oo";
import "oostd/sec/warrant_grp/warrant.oo";
import "oostd/sec/attest.oo";
import "oostd/sec/audit.oo";
import "oostd/sec/blackbox_grp/blackbox.oo";
import "oostd/sec/speculate_grp/speculate.oo";
import "oostd/sec/quorum_grp/quorum.oo";
import "oostd/sec/delegate_grp/delegate.oo";
import "oostd/hw/ipc/wire.oo";
type NetPacketDesc = struct {
    buf_phys_addr: Int,
    pkt_len: Int,
    csum_flags: Int,
    status_dd_eop: Int,
    vlan_tag: Int
};
type NetDmaRing = struct {
    bar0_phys: Int,
    rx_ring_phys: Int,
    tx_ring_phys: Int,
    depth: Int,
    rx_tail_rdt: Int,
    tx_tail_tdt: Int,
    epoch: Int,
    causal_root: Int,
    tx_packets: Int,
    rx_packets: Int
};
pub fn net_packet_desc_new(buf_phys: Int, pkt_len: Int, csum_flags: Int, dd_eop: Int, vlan: Int) -> NetPacketDesc {
    return NetPacketDesc {
        buf_phys_addr: if buf_phys < 4096 || (buf_phys % 64) != 0 { 0 } else { buf_phys },
        pkt_len: if pkt_len < 60 || pkt_len > 9216 { 0 } else { pkt_len },
        csum_flags: if csum_flags < 0 { 0 } else { csum_flags },
        status_dd_eop: dd_eop & 3,
        vlan_tag: vlan & 4095
    };
}
pub fn net_dma_ring_init(_dma: &DmaCap, _mmio: &MmioCap, bar0_phys: Int, rx_phys: Int, tx_phys: Int,
    depth: Int) -> NetDmaRing {
    return NetDmaRing {
        bar0_phys: if bar0_phys < 4096 { 4262461440 } else { bar0_phys },
        rx_ring_phys: if rx_phys < 4096 { 2097152 } else { rx_phys },
        tx_ring_phys: if tx_phys < 4096 { 2101248 } else { tx_phys },
        depth: if depth <= 1 || depth > 4096 { 256 } else { depth },
        rx_tail_rdt: 0,
        tx_tail_tdt: 0,
        epoch: 1,
        causal_root: oo_audit_genesis(),
        tx_packets: 0,
        rx_packets: 0
    };
}
pub fn net_tx_submit_desc(ring: NetDmaRing, _dma: &DmaCap, _mmio: &MmioCap, desc: NetPacketDesc) -> NetDmaRing {
    if desc.buf_phys_addr < 4096 || desc.pkt_len < 60 { return ring;
    }
    let caps: Int = (1 << oo_cap_bit_index("DmaCap")) | (1 << oo_cap_bit_index("MmioCap"));
    let parent_reg64: Int = oo_cap_reg64_pack(ring.epoch, 30, 1, caps);
    if oo_warrant_check(parent_reg64, ring.epoch, caps, 24) == false { return ring;
    }
    let turn: OodaTurn = oo_ooda_cycle(parent_reg64, ring.epoch, 24, caps, 100, desc.buf_phys_addr, desc.pkt_len,
        desc.csum_flags + 1, desc.vlan_tag + 1, ring.tx_packets + 1, 17, 29);
    let next_ep: Int = turn.epoch;
    let child_reg64: Int = oo_cap_reg64_pack(next_ep, 30, 2, caps);
    let dseal: Int = oo_delegate_seal(ring.causal_root, child_reg64, 24, 17, 29);
    let d_ok: Bool = oo_delegate_gate(parent_reg64, child_reg64, caps, ring.epoch, next_ep, 24, ring.causal_root, dseal, 17,
        29);
    let ckpt: Ckpt = oo_ckpt_new(desc.buf_phys_addr, turn.causal_root, child_reg64);
    let seal: Int = oo_attest_seal(child_reg64, 24, ckpt.causal_root, 17, 29);
    let next_root: Int = oo_speculate(ckpt, next_ep, caps, 24, seal, 17, 29, desc.pkt_len);
    let fr: Wire = oo_wire_decode(oo_wire_encode(5, 24, child_reg64, desc.buf_phys_addr, desc.pkt_len, desc.vlan_tag, next_ep,
        next_root));
    if turn.committed == false || d_ok == false || next_root <= ckpt.causal_root || fr.valid == false {
        return ring;
    }
    return NetDmaRing {
        bar0_phys: ring.bar0_phys,
        rx_ring_phys: ring.rx_ring_phys,
        tx_ring_phys: ring.tx_ring_phys,
        depth: ring.depth,
        rx_tail_rdt: ring.rx_tail_rdt,
        tx_tail_tdt: (ring.tx_tail_tdt + 1) % ring.depth,
        epoch: next_ep,
        causal_root: next_root,
        tx_packets: ring.tx_packets + 1,
        rx_packets: ring.rx_packets
    };
}
pub fn net_rx_poll_desc(ring: NetDmaRing, _dma: &DmaCap, desc: NetPacketDesc) -> NetDmaRing {
    if desc.status_dd_eop != 3 || desc.pkt_len < 60 { return ring;
    }
    return NetDmaRing {
        bar0_phys: ring.bar0_phys,
        rx_ring_phys: ring.rx_ring_phys,
        tx_ring_phys: ring.tx_ring_phys,
        depth: ring.depth,
        rx_tail_rdt: (ring.rx_tail_rdt + 1) % ring.depth,
        tx_tail_tdt: ring.tx_tail_tdt,
        epoch: ring.epoch,
        causal_root: oo_audit_link(ring.causal_root, desc.pkt_len),
        tx_packets: ring.tx_packets,
        rx_packets: ring.rx_packets + 1
    };
}
pub fn net_quorum_blackbox_verify(ring: NetDmaRing, msix_vec: Int) -> Bool {
    if msix_vec < 0 || msix_vec > 255 { return false;
    }
    let caps: Int = (1 << oo_cap_bit_index("DmaCap")) | (1 << oo_cap_bit_index("MmioCap"));
    let rights: Int = 30 | msix_vec;
    let v1: Int = oo_cap_reg64_pack(ring.epoch, rights, 1, caps);
    let v2: Int = oo_cap_reg64_pack(ring.epoch, rights, 2, caps);
    let v3: Int = oo_cap_reg64_pack(ring.epoch, rights, 3, caps);
    let mut votes: List[Int] = list_new();
    votes = list_push(votes, v1);
    votes = list_push(votes, v2);
    votes = list_push(votes, v3);
    let qseal: Int = oo_quorum_seal(v1, 24, ring.causal_root, 17, 29);
    let q_ok: Bool = oo_quorum_act_gate(votes, 1, v1, ring.epoch, caps, 24, ring.causal_root, qseal, 17, 29);
    let bb_seal: Int = oo_blackbox_seal(msix_vec, v1, ring.tx_packets + ring.rx_packets + 1, ring.causal_root, 17, 29);
    let bb_ok: Bool = oo_blackbox_replay(bb_seal, msix_vec, v1, ring.epoch, caps, ring.tx_packets + ring.rx_packets + 1,
        ring.causal_root, 17, 29);
    return q_ok && bb_ok;
}