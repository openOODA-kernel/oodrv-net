// # oodrv-net Zero-Copy Packet Rings, In-Kernel TLS Record Offload & Time-Based Pacing
//
// Logline: Zero-copy packet-ring RX/TX slots, in-kernel PQC-TLS framing, and paced flight recording.
//
// Setup: Deterministic packet-ring/TLS/pacing datapath sealed with oo_pqc_sha3_round; reg64 gate fails closed.
//
// Beats:
//   1. Advance zero-copy packet-ring ring cursors (head/cur/tail) without per-packet skb/mbuf allocation.
//   2. Frame and seal outgoing records in-kernel via PQC-TLS AEAD offload.
//   3. Compute bottleneck-bandwidth pacing rate and time-based loss recovery with flight-record circular event digesting.
//   4. Admit only with a live reg64 epoch and the NetCap bit; the gated entry returns the empty ring on deny.
import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";
type PktRing = struct {
    ring_slots: Int,
    head_idx: Int,
    tail_idx: Int,
    tls_active: Bool,
    pacing_mbps: Int,
    flight_digest: Int
};
pub fn pktio_seal(slots: Int, head: Int, tail: Int, tls: Bool, mbps: Int) -> Int {
    let kbit: Int = (if tls { 1 } else { 0 }) + oo_cap_bit_index("NetCap");
    let h1: Int = oo_pqc_sha3_round(slots * 256 + head, tail);
    return oo_pqc_sha3_round(h1, mbps * 2 + kbit);
}
pub fn pktio_open(slots: Int, tls_enable: Bool, bw_mbps: Int, rtt_us: Int) -> PktRing {
    if slots <= 0 || bw_mbps <= 0 || rtt_us <= 0 {
        return PktRing { ring_slots: 0, head_idx: 0, tail_idx: 0, tls_active: false, pacing_mbps: 0, flight_digest: 0 };
    }
    let tail: Int = slots - 1;
    let dig: Int = pktio_seal(slots, 0, tail, tls_enable, bw_mbps);
    return PktRing { ring_slots: slots, head_idx: 0, tail_idx: tail, tls_active: tls_enable, pacing_mbps: bw_mbps,
        flight_digest: dig };
}
pub fn pktio_tx_batch(r: PktRing, batch_pkts: Int, rack_reorder_win_us: Int) -> PktRing {
    if r.ring_slots <= 0 || r.tls_active == false || batch_pkts <= 0 || batch_pkts > r.ring_slots || rack_reorder_win_us < 0 {
        return r;
    }
    let next_head: Int = (r.head_idx + batch_pkts) % r.ring_slots;
    let dig: Int = oo_pqc_sha3_round(pktio_seal(r.ring_slots, next_head, r.tail_idx, true, r.pacing_mbps), rack_reorder_win_us);
    return PktRing { ring_slots: r.ring_slots, head_idx: next_head, tail_idx: r.tail_idx, tls_active: true,
        pacing_mbps: r.pacing_mbps, flight_digest: dig };
}
pub fn pktio_admit(reg64: Int, epoch: Int, req_rights: Int) -> Int {
    let req_caps: Int = 1 << oo_cap_bit_index("NetCap");
    if reg64 == 0 { return 0 - 13;
    }
    if epoch < 0 || req_rights < 0 || req_rights > 255 { return 0 - 22;
    }
    if oo_cap_reg64_check(reg64, epoch, req_rights, req_caps) == false { return 0 - 13;
    }
    return 0;
}
pub fn pktio_open_gated(reg64: Int, epoch: Int, req_rights: Int, slots: Int, tls_enable: Bool, bw_mbps: Int,
    rtt_us: Int) -> PktRing {
    if pktio_admit(reg64, epoch, req_rights) != 0 {
        return PktRing { ring_slots: 0, head_idx: 0, tail_idx: 0, tls_active: false, pacing_mbps: 0, flight_digest: 0 };
    }
    return pktio_open(slots, tls_enable, bw_mbps, rtt_us);
}