// # oodrv-pci Zero-Copy RDMA / RoCEv2 / InfiniBand QP & Memory Region Capability Guard
//
// Logline: Fail-closed admit gate for zero-copy RDMA Queue-Pair setup and Memory Region rkey/lkey exposure.
//
// Setup: Requires NetCap and DmaCap in the caller CapReg64; the denied path returns the empty guard record.
//
// Beats:
//   1. Declare the admitted RDMA QP + MR guard record.
//   2. Validate 24-bit queue-pair numbers, nonzero 32-bit rkey/lkey, and nonzero protection domains.
//   3. Apply the canonical reg64 admit gate (zero register, epoch/rights range, capability check) before sealing.
import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";

type RdmaQpGuard = struct {
    qp_num: Int,
    pd_handle: Int,
    mr_lkey: Int,
    mr_rkey: Int,
    admitted: Bool,
    seal: Int
};

pub fn rdma_qp_max_num() -> Int {
    return 16777215;
}
pub fn rdma_mr_key_max() -> Int {
    return 4294967295;
}
pub fn rdma_qp_req_caps() -> Int {
    let net_b: Int = 1 << oo_cap_bit_index("NetCap");
    let dma_b: Int = 1 << oo_cap_bit_index("DmaCap");
    return net_b | dma_b;
}
pub fn rdma_qp_num_ok(qp_num: Int) -> Bool {
    return qp_num > 0 && qp_num <= rdma_qp_max_num();
}
pub fn rdma_mr_key_ok(key: Int) -> Bool {
    return key > 0 && key <= rdma_mr_key_max();
}

pub fn rdma_qp_admit_gated(reg64: Int, epoch: Int, req_rights: Int, qp_num: Int, pd_handle: Int,
        mr_lkey: Int, mr_rkey: Int) -> RdmaQpGuard {
    let deny: RdmaQpGuard = RdmaQpGuard { qp_num: 0, pd_handle: 0, mr_lkey: 0, mr_rkey: 0,
        admitted: false, seal: 0 };
    if reg64 == 0 { return deny;
    }
    if epoch < 0 || req_rights < 0 || req_rights > 255 { return deny;
    }
    if oo_cap_reg64_check(reg64, epoch, req_rights, rdma_qp_req_caps()) == false { return deny;
    }
    if pd_handle <= 0 || rdma_qp_num_ok(qp_num) == false { return deny;
    }
    if rdma_mr_key_ok(mr_lkey) == false || rdma_mr_key_ok(mr_rkey) == false { return deny;
    }
    let sl: Int = oo_pqc_sha3_round(reg64 ^ (qp_num << 8) ^ mr_rkey, (pd_handle << 4) ^ epoch);
    return RdmaQpGuard { qp_num: qp_num, pd_handle: pd_handle, mr_lkey: mr_lkey, mr_rkey: mr_rkey,
        admitted: true, seal: sl };
}
