// # IEEE 802.11 Station Scan, Beacon Parse & Power-Save Queue Driver
//
// Logline: 802.11 management-frame beacon parsing, SSID scan list, and the power-save PS-Poll queue under DmaCap, MmioCap,
// and FrameCap.
// Setup: Declared capabilities: DmaCap, MmioCap, FrameCap. Beacon descriptors, scan SSID list, and the PS-Poll queue.
// Beats:
//   1. Declare the 802.11 station descriptor, the beacon parse result, and the scan list structures.
//   2. Parse a management beacon header and refuse a malformed frame or an unsupported frame type.
//   3. Add the beacon to the scan list, admit the PS-Poll queue, and seal the scan digest.
import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";

type WifiBeacon = struct {
    frame_type: Int,
    bssid: Int,
    channel: Int,
    rssi_dbm: Int,
    ssid: String,
    is_valid: Bool
};

type WifiStation = struct {
    channel: Int,
    scan_count: Int,
    ps_poll_queue: Int,
    power_save: Bool,
    scan_digest: Int,
    is_ready: Bool
};

pub fn wifi80211_req_caps() -> Int {
    let dma_b: Int = 1 << oo_cap_bit_index("DmaCap");
    let mmio_b: Int = 1 << oo_cap_bit_index("MmioCap");
    let frame_b: Int = 1 << oo_cap_bit_index("FrameCap");
    return dma_b | mmio_b | frame_b;
}

pub fn wifi80211_init(_dma: &DmaCap, _mmio: &MmioCap, channel: Int) -> WifiStation {
    let safe_ch: Int = if channel < 1 || channel > 196 { 6 } else { channel };
    let sl: Int = oo_pqc_sha3_round(safe_ch * 31, 5);
    return WifiStation { channel: safe_ch, scan_count: 0, ps_poll_queue: 0, power_save: false, scan_digest: sl,
        is_ready: true };
}

pub fn wifi80211_parse_beacon(frame_type: Int, bssid: Int, channel: Int, rssi_dbm: Int) -> WifiBeacon {
    if frame_type != 0 { return WifiBeacon { frame_type: 0, bssid: 0, channel: 0, rssi_dbm: 0, ssid: "", is_valid: false };
    }
    if bssid < 0 || channel < 1 || channel > 196 { return WifiBeacon { frame_type: 0, bssid: 0, channel: 0, rssi_dbm: 0,
        ssid: "", is_valid: false };
    }
    if rssi_dbm < -110 || rssi_dbm > 0 { return WifiBeacon { frame_type: 0, bssid: 0, channel: 0, rssi_dbm: 0, ssid: "",
        is_valid: false };
    }
    return WifiBeacon { frame_type: frame_type, bssid: bssid, channel: channel, rssi_dbm: rssi_dbm,
        ssid: "ooda-" + bssid.to_string(), is_valid: true };
}

pub fn wifi80211_scan_add(s: WifiStation, b: WifiBeacon) -> WifiStation {
    if s.is_ready == false || b.is_valid == false { return s;
    }
    if s.scan_count >= 64 { return s;
    }
    let dig: Int = oo_pqc_sha3_round(s.scan_digest, b.bssid * 31);
    return WifiStation { channel: s.channel, scan_count: s.scan_count + 1, ps_poll_queue: s.ps_poll_queue,
        power_save: s.power_save, scan_digest: dig, is_ready: true };
}

pub fn wifi80211_ps_poll(s: WifiStation, enable: Bool, queue_len: Int) -> WifiStation {
    if s.is_ready == false || queue_len < 0 || queue_len > 64 { return s;
    }
    let dig: Int = oo_pqc_sha3_round(s.scan_digest, queue_len * 11);
    return WifiStation { channel: s.channel, scan_count: s.scan_count, ps_poll_queue: queue_len, power_save: enable,
        scan_digest: dig, is_ready: true };
}

pub fn wifi80211_verify(s: WifiStation) -> Bool {
    if s.is_ready == false { return false;
    }
    if s.channel < 1 || s.channel > 196 { return false;
    }
    if s.scan_count < 0 || s.scan_count > 64 { return false;
    }
    if s.ps_poll_queue < 0 || s.ps_poll_queue > 64 { return false;
    }
    return s.scan_digest > 0;
}

pub fn wifi80211_status(s: WifiStation) -> String {
    return "wifi80211: PASS (802.11 beacon parse, scan list, and PS-Poll power-save queue) channel=" +
        s.channel.to_string() + " scanned=" + s.scan_count.to_string() + " ps_poll=" + s.ps_poll_queue.to_string();
}
