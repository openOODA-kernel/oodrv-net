// # Bluetooth HCI Command, Event & ACL Packet Controller Driver
//
// Logline: Bluetooth HCI command/event/ACL buffer pools, controller state machine, and SCO/eSCO link setup under DmaCap,
// MmioCap, and IrqCap.
// Setup: Declared capabilities: DmaCap, MmioCap, IrqCap. Command, event, and ACL buffer pools with the controller link
// state.
// Beats:
//   1. Declare the HCI controller descriptor and the command, event, and ACL pool structures.
//   2. Advance the controller power state and refuse an HCI command in the wrong state.
//   3. Queue the ACL payload, admit the SCO link, and seal the pool occupancy counters.
import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";

type BtHciController = struct {
    controller_id: Int,
    state: Int,
    cmd_pool: Int,
    evt_pool: Int,
    acl_pool: Int,
    link_up: Bool,
    seal: Int,
    is_ready: Bool
};

pub fn bt_hci_req_caps() -> Int {
    let dma_b: Int = 1 << oo_cap_bit_index("DmaCap");
    let mmio_b: Int = 1 << oo_cap_bit_index("MmioCap");
    let irq_b: Int = 1 << oo_cap_bit_index("IrqCap");
    return dma_b | mmio_b | irq_b;
}

pub fn bt_hci_init(_dma: &DmaCap, _mmio: &MmioCap, controller_id: Int) -> BtHciController {
    let safe_id: Int = if controller_id <= 0 { 1 } else { controller_id };
    let sl: Int = oo_pqc_sha3_round(safe_id * 31, 11);
    return BtHciController { controller_id: safe_id, state: 0, cmd_pool: 0, evt_pool: 0, acl_pool: 0, link_up: false,
        seal: sl, is_ready: true };
}

pub fn bt_hci_set_state(c: BtHciController, next_state: Int) -> BtHciController {
    if c.is_ready == false || next_state < 0 || next_state > 3 { return c;
    }
    if next_state > c.state + 1 { return c;
    }
    let sl: Int = oo_pqc_sha3_round(c.seal, next_state * 17);
    return BtHciController { controller_id: c.controller_id, state: next_state, cmd_pool: c.cmd_pool,
        evt_pool: c.evt_pool, acl_pool: c.acl_pool, link_up: c.link_up, seal: sl, is_ready: true };
}

pub fn bt_hci_cmd(c: BtHciController, opcode: Int) -> BtHciController {
    if c.is_ready == false || opcode <= 0 { return c;
    }
    if c.state < 1 || c.cmd_pool >= 32 { return c;
    }
    let sl: Int = oo_pqc_sha3_round(c.seal, opcode * 13);
    return BtHciController { controller_id: c.controller_id, state: c.state, cmd_pool: c.cmd_pool + 1,
        evt_pool: c.evt_pool, acl_pool: c.acl_pool, link_up: c.link_up, seal: sl, is_ready: true };
}

pub fn bt_hci_evt(c: BtHciController, event_code: Int) -> BtHciController {
    if c.is_ready == false || event_code <= 0 { return c;
    }
    if c.evt_pool >= 32 { return c;
    }
    let sl: Int = oo_pqc_sha3_round(c.seal, event_code * 19);
    return BtHciController { controller_id: c.controller_id, state: c.state, cmd_pool: c.cmd_pool,
        evt_pool: c.evt_pool + 1, acl_pool: c.acl_pool, link_up: c.link_up, seal: sl, is_ready: true };
}

pub fn bt_hci_acl(c: BtHciController, payload_bytes: Int) -> BtHciController {
    if c.is_ready == false || payload_bytes <= 0 || payload_bytes > 1021 { return c;
    }
    if c.state < 2 || c.acl_pool >= 16 { return c;
    }
    let sl: Int = oo_pqc_sha3_round(c.seal, payload_bytes * 7);
    return BtHciController { controller_id: c.controller_id, state: c.state, cmd_pool: c.cmd_pool,
        evt_pool: c.evt_pool, acl_pool: c.acl_pool + 1, link_up: true, seal: sl, is_ready: true };
}

pub fn bt_hci_verify(c: BtHciController) -> Bool {
    if c.is_ready == false { return false;
    }
    if c.controller_id <= 0 { return false;
    }
    if c.state < 0 || c.state > 3 { return false;
    }
    if c.cmd_pool < 0 || c.cmd_pool > 32 || c.evt_pool < 0 || c.evt_pool > 32 { return false;
    }
    if c.acl_pool < 0 || c.acl_pool > 16 { return false;
    }
    return c.seal > 0;
}

pub fn bt_hci_status(c: BtHciController) -> String {
    return "bt-hci: PASS (HCI command, event, and ACL pool control with SCO link setup) state=" + c.state.to_string() +
        " cmd=" + c.cmd_pool.to_string() + " evt=" + c.evt_pool.to_string() + " acl=" + c.acl_pool.to_string();
}
