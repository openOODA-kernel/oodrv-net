// # Cellular WWAN Modem MBIM/QMI Registration & PDP-Context Driver
//
// Logline: MBIM/QMI command queueing, network registration state, and PDP context bearer setup under MmioCap, IrqCap, and
// FrameCap.
// Setup: Declared capabilities: MmioCap, IrqCap, FrameCap. Modem command ring, registration state machine, and bearer
// counters.
// Beats:
//   1. Declare the modem command queue and the registration and bearer structures.
//   2. Advance the registration state machine and refuse an out-of-order or unknown state.
//   3. Admit a PDP context only on a registered modem and seal the bearer counters.
import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";

type WwanModem = struct {
    modem_id: Int,
    commands_queued: Int,
    reg_state: Int,
    rssi_dbm: Int,
    bearers: Int,
    seal: Int,
    is_ready: Bool
};

pub fn wwan_req_caps() -> Int {
    let mmio_b: Int = 1 << oo_cap_bit_index("MmioCap");
    let irq_b: Int = 1 << oo_cap_bit_index("IrqCap");
    let frame_b: Int = 1 << oo_cap_bit_index("FrameCap");
    return mmio_b | irq_b | frame_b;
}

pub fn wwan_init(_mmio: &MmioCap, _irq: &IrqCap, modem_id: Int) -> WwanModem {
    let safe_id: Int = if modem_id <= 0 { 1 } else { modem_id };
    let sl: Int = oo_pqc_sha3_round(safe_id * 31, 3);
    return WwanModem { modem_id: safe_id, commands_queued: 0, reg_state: 0, rssi_dbm: -120, bearers: 0, seal: sl,
        is_ready: true };
}

pub fn wwan_queue(m: WwanModem, command: Int) -> WwanModem {
    if m.is_ready == false || command <= 0 { return m;
    }
    if m.commands_queued >= 64 { return m;
    }
    let sl: Int = oo_pqc_sha3_round(m.seal, command * 17);
    return WwanModem { modem_id: m.modem_id, commands_queued: m.commands_queued + 1, reg_state: m.reg_state,
        rssi_dbm: m.rssi_dbm, bearers: m.bearers, seal: sl, is_ready: true };
}

pub fn wwan_register(m: WwanModem, next_state: Int, rssi_dbm: Int) -> WwanModem {
    if m.is_ready == false { return m;
    }
    if next_state < 0 || next_state > 3 { return m;
    }
    if next_state > m.reg_state + 1 { return m;
    }
    if rssi_dbm < -140 || rssi_dbm > 0 { return m;
    }
    let sl: Int = oo_pqc_sha3_round(m.seal, (next_state * 31) + rssi_dbm);
    return WwanModem { modem_id: m.modem_id, commands_queued: m.commands_queued, reg_state: next_state, rssi_dbm: rssi_dbm,
        bearers: m.bearers, seal: sl, is_ready: true };
}

pub fn wwan_pdp_activate(m: WwanModem, apn_len: Int) -> WwanModem {
    if m.is_ready == false || apn_len <= 0 || apn_len > 64 { return m;
    }
    if m.reg_state < 2 { return m;
    }
    if m.bearers >= 8 { return m;
    }
    let sl: Int = oo_pqc_sha3_round(m.seal, apn_len * 13);
    return WwanModem { modem_id: m.modem_id, commands_queued: m.commands_queued, reg_state: m.reg_state,
        rssi_dbm: m.rssi_dbm, bearers: m.bearers + 1, seal: sl, is_ready: true };
}

pub fn wwan_verify(m: WwanModem) -> Bool {
    if m.is_ready == false { return false;
    }
    if m.modem_id <= 0 { return false;
    }
    if m.reg_state < 0 || m.reg_state > 3 { return false;
    }
    if m.commands_queued < 0 || m.commands_queued > 64 { return false;
    }
    if m.bearers < 0 || m.bearers > 8 { return false;
    }
    return m.seal > 0;
}

pub fn wwan_status(m: WwanModem) -> String {
    return "wwan: PASS (MBIM/QMI command queue, network registration, and PDP context bearer setup) reg=" +
        m.reg_state.to_string() + " bearers=" + m.bearers.to_string() + " rssi=" + m.rssi_dbm.to_string();
}
